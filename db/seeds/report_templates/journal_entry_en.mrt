                "Value": "<b>{root_items.account_code} - {root_items.account_name}</b>\n{\n    IIF(root_items.center_1_code != \"\", \"<div> &nbsp;&nbsp;&nbsp;&nbsp; \" + root_items.center_1_code + \" - \" + root_items.center_1_name + \"</div>\", \"\") +\n    IIF(root_items.center_2_code != \"\", \"<div> &nbsp;&nbsp;&nbsp;&nbsp; \" + root_items.center_2_code + \" - \" + root_items.center_2_name + \"</div>\", \"\") +\n    IIF(root_items.center_3_code != \"\", \"<div> &nbsp;&nbsp;&nbsp;&nbsp; \" + root_items.center_3_code + \" - \" + root_items.center_3_name + \"</div>\", \"\") +\n    IIF(root_items.center_4_code != \"\", \"<div> &nbsp;&nbsp;&nbsp;&nbsp; \" + root_items.center_4_code + \" - \" + root_items.center_4_name + \"</div>\", \"\") +\n    IIF(root_items.center_5_code != \"\", \"<div> &nbsp;&nbsp;&nbsp;&nbsp; \" + root_items.center_5_code + \" - \" + root_items.center_5_name + \"</div>\", \"\") +\n    IIF(root_items.center_6_code != \"\", \"<div> &nbsp;&nbsp;&nbsp;&nbsp; \" + root_items.center_6_code + \" - \" + root_items.center_6_name + \"</div>\", \"\")\n}"
              },
              "VertAlignment": "Center",
              "Font": "Roboto;10;;",
              "Border": "All;216,216,216;;;;;;solid:Black",
              "Brush": "solid:",
              "TextBrush": "solid:Black",
